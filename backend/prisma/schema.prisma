generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so role/status fields are plain strings
// whose allowed values are validated at the application layer (see src/utils/enums.ts).

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())

  verifiedTransactions    ShareTransaction[]     @relation("VerifiedBy")
  certificateRequestsMade CertificateRequest[]   @relation("CertRequestedBy")
  certificateRequestsDone CertificateRequest[]   @relation("CertApprovedBy")
  certificateHistory      CertificateHistory[]   @relation("HistoryPerformedBy")
  printJobsRequested      PrintJob[]             @relation("PrintRequestedBy")
  printJobsApproved       PrintJob[]             @relation("PrintApprovedBy")
  printJobsPrinted        PrintJob[]             @relation("PrintPrintedBy")
  activityLogs            ActivityLog[]
}

model Shareholder {
  id          Int      @id @default(autoincrement())
  fullName    String
  nationalId  String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())

  transactions ShareTransaction[]
  certificates Certificate[]
}

model ShareTransaction {
  id             Int               @id @default(autoincrement())
  transactionNo  String            @unique
  shareholderId  Int
  shareholder    Shareholder       @relation(fields: [shareholderId], references: [id])
  shareQuantity  Int
  pricePerShare  Float
  paymentInfo    String
  submittedVia   String
  status         String            @default("PENDING_VERIFICATION")
  verifiedById   Int?
  verifiedBy     User?             @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt     DateTime?
  createdAt      DateTime          @default(now())

  certificateRequests CertificateRequest[]
}

model CertificateRequest {
  id             Int                       @id @default(autoincrement())
  transactionId  Int
  transaction    ShareTransaction          @relation(fields: [transactionId], references: [id])
  requestedById  Int
  requestedBy    User                      @relation("CertRequestedBy", fields: [requestedById], references: [id])
  status         String                    @default("PENDING_APPROVAL")
  approvedById   Int?
  approvedBy     User?                     @relation("CertApprovedBy", fields: [approvedById], references: [id])
  decidedAt      DateTime?
  rejectionNote  String?
  createdAt      DateTime                  @default(now())

  certificate Certificate?
}

model Certificate {
  id                    Int                  @id @default(autoincrement())
  certificateNo         String               @unique
  barcodeValue          String
  certificateRequestId  Int                  @unique
  certificateRequest    CertificateRequest   @relation(fields: [certificateRequestId], references: [id])
  shareholderId         Int
  shareholder           Shareholder          @relation(fields: [shareholderId], references: [id])
  shareQuantity         Int
  issueDate             DateTime             @default(now())
  status                String               @default("ISSUED")

  replacesCertificateId Int?     @unique
  replacesCertificate   Certificate?  @relation("CertificateLineage", fields: [replacesCertificateId], references: [id])
  replacedByCertificate Certificate?  @relation("CertificateLineage")

  history    CertificateHistory[]
  printJobs  PrintJob[]
}

model CertificateHistory {
  id             Int         @id @default(autoincrement())
  certificateId  Int
  certificate    Certificate @relation(fields: [certificateId], references: [id])
  action         String
  notes          String?
  performedById  Int
  performedBy    User        @relation("HistoryPerformedBy", fields: [performedById], references: [id])
  createdAt      DateTime    @default(now())
}

model PrintJob {
  id             Int             @id @default(autoincrement())
  certificateId  Int
  certificate    Certificate     @relation(fields: [certificateId], references: [id])
  requestedById  Int
  requestedBy    User            @relation("PrintRequestedBy", fields: [requestedById], references: [id])
  approvedById   Int?
  approvedBy     User?           @relation("PrintApprovedBy", fields: [approvedById], references: [id])
  status         String          @default("REQUESTED")
  rejectionNote  String?
  printedAt      DateTime?
  printedById    Int?
  printedBy      User?           @relation("PrintPrintedBy", fields: [printedById], references: [id])
  createdAt      DateTime        @default(now())
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   Int?
  details    String?
  createdAt  DateTime @default(now())
}
