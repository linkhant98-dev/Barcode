@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using EMS.Infrastructure.Identity
@using EMS.Infrastructure.Persistence
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Localizer
@inject EmsDbContext Db
@{
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var recentNotifications = currentUserId is null
        ? new List<EMS.Domain.Notifications.Notification>()
        : await Db.Notifications.Where(n => n.UserId == currentUserId).OrderByDescending(n => n.CreatedAtUtc).Take(6).ToListAsync();
    var unreadCount = currentUserId is null ? 0 : await Db.Notifications.CountAsync(n => n.UserId == currentUserId && !n.IsRead);
}

<header class="cb-header no-print">
    <a class="cb-header__brand" asp-controller="Dashboard" asp-action="Index" style="text-decoration:none;">
        <span class="cb-logo-mark">CB</span>
        <span>
            Equity Management System
        </span>
    </a>
    <div class="cb-header__actions">
        <span class="cb-env-badge d-none d-md-inline">@(System.Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Development")</span>

        <form asp-controller="Account" asp-action="SetLanguage" method="post" class="d-none d-md-block">
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <select name="culture" class="form-select form-select-sm" style="width:auto;min-height:auto;" onchange="this.form.submit()" aria-label="Language">
                <option value="en" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "en")">EN</option>
                <option value="my" selected="@(System.Globalization.CultureInfo.CurrentUICulture.Name == "my")">မြန်မာ</option>
            </select>
        </form>

        <div class="dropdown">
            <button class="btn btn-link text-decoration-none position-relative p-0 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" aria-label="Notifications">
                <i class="bi bi-bell text-secondary-cb fs-5"></i>
                @if (unreadCount > 0)
                {
                    <span class="badge rounded-pill" style="position:absolute;top:-6px;right:-8px;background:var(--cb-red-500);font-size:10px;">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                }
            </button>
            <div class="dropdown-menu dropdown-menu-end p-0" style="min-width:320px;">
                <div class="px-3 py-2 border-bottom fw-bold small">Notifications</div>
                @if (recentNotifications.Count == 0)
                {
                    <div class="px-3 py-3 text-secondary-cb small">No notifications yet.</div>
                }
                else
                {
                    @foreach (var n in recentNotifications)
                    {
                        <a class="dropdown-item @(n.IsRead ? "" : "fw-bold")" href="@(n.LinkUrl ?? "/Notifications")" style="white-space:normal;">
                            <div class="small">@n.Title</div>
                            <div class="text-secondary-cb" style="font-size:11px;">@n.CreatedAtUtc.ToString("dd MMM HH:mm")</div>
                        </a>
                    }
                }
                <a class="dropdown-item text-center small border-top" asp-controller="Notifications" asp-action="Index">View all</a>
            </div>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="dropdown">
                <button class="btn btn-cb-outline btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle"></i> @User.Identity!.Name
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-item-text small text-secondary-cb">@string.Join(", ", User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</span></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item">@Localizer["SignOut"]</button>
                        </form>
                    </li>
                </ul>
            </div>
        }
    </div>
</header>
