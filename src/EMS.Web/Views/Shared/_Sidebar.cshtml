@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    var controller = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    bool Active(params string[] controllers) => controllers.Contains(controller, StringComparer.OrdinalIgnoreCase);
}
<aside class="cb-sidebar no-print" id="cb-sidebar">
    <a class="sidebar-link @(Active("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-speedometer2"></i> @Localizer["Dashboard"]
    </a>

    <div class="cb-sidebar__section-title">Shareholder Management</div>
    <a class="sidebar-link @(Active("ShareholderApplications") ? "active" : "")" asp-controller="ShareholderApplications" asp-action="Index">
        <i class="bi bi-person-vcard"></i> @Localizer["ShareholderApplications"]
    </a>
    <a class="sidebar-link @(Active("Kyc") ? "active" : "")" asp-controller="Kyc" asp-action="Index">
        <i class="bi bi-shield-check"></i> @Localizer["KycQueue"]
    </a>
    <a class="sidebar-link @(Active("Shareholders") ? "active" : "")" asp-controller="Shareholders" asp-action="Index">
        <i class="bi bi-people"></i> @Localizer["RegisteredShareholders"]
    </a>
    <a class="sidebar-link @(Active("Certificates") ? "active" : "")" asp-controller="Certificates" asp-action="Index">
        <i class="bi bi-award"></i> @Localizer["Certificates"]
    </a>

    <div class="cb-sidebar__section-title">Share Operations</div>
    <a class="sidebar-link @(Active("IssueShares") ? "active" : "")" asp-controller="IssueShares" asp-action="Index">
        <i class="bi bi-file-earmark-plus"></i> @Localizer["IssueShares"]
    </a>
    <a class="sidebar-link @(Active("TransferShares") ? "active" : "")" asp-controller="TransferShares" asp-action="Index">
        <i class="bi bi-arrow-left-right"></i> @Localizer["TransferShares"]
    </a>
    <a class="sidebar-link @(Active("Bonus") ? "active" : "")" asp-controller="Bonus" asp-action="Index">
        <i class="bi bi-gift"></i> @Localizer["BonusShares"]
    </a>
    <a class="sidebar-link @(Active("Dividends") ? "active" : "")" asp-controller="Dividends" asp-action="Index">
        <i class="bi bi-cash-stack"></i> @Localizer["Dividends"]
    </a>

    <div class="cb-sidebar__section-title">Workflow</div>
    <a class="sidebar-link @(Active("Approvals") ? "active" : "")" asp-controller="Approvals" asp-action="Index">
        <i class="bi bi-check2-square"></i> @Localizer["PendingApprovals"]
    </a>
    <a class="sidebar-link @(Active("Approvals") ? "active" : "")" asp-controller="Approvals" asp-action="SubmittedByMe">
        <i class="bi bi-send"></i> @Localizer["SubmittedByMe"]
    </a>

    <div class="cb-sidebar__section-title">Reports</div>
    <a class="sidebar-link @(Active("Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index">
        <i class="bi bi-bar-chart"></i> @Localizer["Reports"]
    </a>

    <div class="cb-sidebar__section-title">Administration</div>
    <a class="sidebar-link @(Active("Users") ? "active" : "")" asp-controller="Users" asp-action="Index">
        <i class="bi bi-person-gear"></i> @Localizer["UsersAndRoles"]
    </a>
    <a class="sidebar-link @(Active("ApprovalMatrix") ? "active" : "")" asp-controller="ApprovalMatrix" asp-action="Index">
        <i class="bi bi-diagram-3"></i> @Localizer["ApprovalMatrix"]
    </a>
    <a class="sidebar-link @(Active("MasterData") ? "active" : "")" asp-controller="MasterData" asp-action="Index">
        <i class="bi bi-database"></i> @Localizer["MasterData"]
    </a>
    <a class="sidebar-link @(Active("Audit") ? "active" : "")" asp-controller="Audit" asp-action="Index">
        <i class="bi bi-journal-text"></i> @Localizer["AuditLog"]
    </a>
</aside>
