@model List<EMS.Domain.Workflow.Delegation>
@{
    var userNames = (Dictionary<string, string>)ViewBag.UserNames;
    var header = new PageHeaderViewModel
    {
        Title = "Delegations",
        Description = "Temporary delegation of your approval authority.",
        PrimaryAction = new PageAction("New Delegation", Url.Action("Create")!, "primary", "bi-person-lines-fill")
    };
}
<partial name="_PageHeader" model="header" />
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>Delegate to</th><th>Role</th><th>Start</th><th>End</th><th>Reason</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7"><div class="cb-empty-state">You have not delegated any approval authority.</div></td></tr>
                }
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@userNames.GetValueOrDefault(d.ToUserId, d.ToUserId)</td>
                        <td>@d.ApproverRole</td>
                        <td>@d.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@d.EndDate.ToString("dd MMM yyyy")</td>
                        <td>@d.Reason</td>
                        <td><partial name="_StatusBadge" model="@(d.IsActive ? "Active" : "Cancelled")" /></td>
                        <td>
                            @if (d.IsActive)
                            {
                                <form asp-action="End" asp-route-id="@d.Id" method="post" onsubmit="return confirm('End this delegation?');">
                                    <button type="submit" class="btn btn-cb-outline btn-sm">End</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
