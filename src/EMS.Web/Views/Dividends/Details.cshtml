@model EMS.Domain.CorporateActions.DividendEvent
@{
    var header = new PageHeaderViewModel
    {
        Title = Model.DividendEventNo,
        Description = $"{Model.FinancialYear} | {Model.DividendPercentage:N2}% | MMK {Model.CapitalValuePerShare:N0} per share | {Model.BatchVersion}",
        StatusBadge = Model.Status.ToString()
    };
}
<partial name="_PageHeader" model="header" />
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="row g-3">
    <div class="col-lg-9">
        <div class="cb-table-card mb-3">
            <div class="cb-table-responsive">
                <table class="cb-table">
                    <thead>
                        <tr>
                            <th>Shareholder</th><th class="numeric">Old shares</th><th class="numeric">New shares</th>
                            <th class="numeric">Total dividend</th><th class="numeric">Outstanding</th>
                            @if (Model.Status == EMS.Domain.Common.WorkflowStatus.Completed) { <th>Settle</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Entitlements.Count == 0)
                        {
                            <tr><td colspan="6"><div class="cb-empty-state">No calculation yet. Run preview to generate entitlements.</div></td></tr>
                        }
                        @foreach (var e in Model.Entitlements)
                        {
                            <tr>
                                <td>@e.Shareholder?.ShareholderNo</td>
                                <td class="numeric">@e.OldShares.ToString("N0")</td>
                                <td class="numeric">@e.NewShares.ToString("N0")</td>
                                <td class="numeric">@e.TotalDividend.ToString("N0")</td>
                                <td class="numeric">@e.OutstandingBalance.ToString("N0")</td>
                                @if (Model.Status == EMS.Domain.Common.WorkflowStatus.Completed)
                                {
                                    <td>
                                        <form asp-action="Settle" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="dividendEventId" value="@Model.Id" />
                                            <input type="hidden" name="entitlementId" value="@e.Id" />
                                            <input type="number" step="0.01" name="cashWithdrawal" class="form-control form-control-sm" placeholder="Cash" style="width:90px;" />
                                            <input type="number" step="0.01" name="accountTransfer" class="form-control form-control-sm" placeholder="Transfer" style="width:90px;" />
                                            <input type="number" step="0.01" name="reinvestedAmount" class="form-control form-control-sm" placeholder="Reinvest" style="width:90px;" />
                                            <button type="submit" class="btn btn-cb-outline btn-sm">Settle</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2">
            @if (Model.Status == EMS.Domain.Common.WorkflowStatus.Draft)
            {
                <form asp-action="Preview" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-cb-outline">Run Calculation Preview</button>
                </form>
                @if (Model.Entitlements.Count > 0)
                {
                    <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-cb-gold">Submit for Approval</button>
                    </form>
                }
            }
        </div>
    </div>
    <div class="col-lg-3">
        <div class="cb-card">
            <h2 class="h6">Approval</h2>
            @if (ViewBag.ApprovalInstance is EMS.Domain.Workflow.ApprovalInstance instance)
            {
                <partial name="_ApprovalTimeline" model="instance" />
            }
            else
            {
                <p class="text-secondary-cb small mb-0">Not yet submitted for approval.</p>
            }
        </div>
    </div>
</div>
