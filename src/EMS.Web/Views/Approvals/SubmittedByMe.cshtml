@model List<EMS.Domain.Workflow.ApprovalInstance>
@{
    var header = new PageHeaderViewModel { Title = "Submitted by Me", Description = $"{Model.Count} submission(s)" };
}
<partial name="_PageHeader" model="header" />

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>Reference</th><th>Module</th><th>Submitted</th><th>Current step</th><th>Status</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5"><div class="cb-empty-state">You haven't submitted anything yet.</div></td></tr>
                }
                @foreach (var instance in Model)
                {
                    var current = instance.Steps.FirstOrDefault(s => s.Sequence == instance.CurrentSequence);
                    <tr>
                        <td>@instance.EntityReference</td>
                        <td>@instance.EntityType</td>
                        <td>@instance.SubmittedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@current?.StepName</td>
                        <td><partial name="_StatusBadge" model="@instance.Status.ToString()" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
