@model List<EMS.Domain.Workflow.ApprovalInstance>
@{
    var header = new PageHeaderViewModel { Title = "Submitted by Me", Description = $"{Model.Count} submission(s)" };
    string[] approverRoles = ["DGM", "Legal", "DMD", "Managing Director", "CEO", "Vice Chairman", "Board of Directors", "CBM"];
}
<partial name="_PageHeader" model="header" />
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>Reference</th><th>Module</th><th>Submitted</th><th>Current step</th><th>Status</th><th>Recall</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="cb-empty-state">You haven't submitted anything yet.</div></td></tr>
                }
                @foreach (var instance in Model)
                {
                    var current = instance.Steps.FirstOrDefault(s => s.Status == EMS.Domain.Common.ApprovalStepStatus.Pending);
                    <tr>
                        <td>@instance.EntityReference</td>
                        <td>@instance.EntityType</td>
                        <td>@instance.SubmittedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@current?.StepName</td>
                        <td><partial name="_StatusBadge" model="@instance.Status.ToString()" /></td>
                        <td>
                            @if (current is not null)
                            {
                                <form asp-action="Recall" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="approvalInstanceId" value="@instance.Id" />
                                    <select name="reassignToRole" class="form-select form-select-sm" style="width:auto;" title="Recall - was assigned to the wrong approver">
                                        @foreach (var role in approverRoles)
                                        {
                                            <option value="@role" selected="@(role == current.ApproverRole)">@role</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-cb-outline btn-sm">Recall</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="cb-help-text mt-2">Recall pulls a case back from the currently-assigned approver (e.g. it was sent to the wrong one) and immediately reassigns it to the approver role you pick - the previous approver can no longer act on it once recalled (3.4).</p>
