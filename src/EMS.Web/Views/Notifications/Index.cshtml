@model List<EMS.Domain.Notifications.Notification>
@{
    var header = new PageHeaderViewModel
    {
        Title = "Notifications",
        Description = $"{Model.Count(n => !n.IsRead)} unread of {Model.Count}"
    };
}
<partial name="_PageHeader" model="header" />

@if (Model.Any(n => !n.IsRead))
{
    <form asp-action="MarkAllRead" method="post" class="mb-3">
        <button type="submit" class="btn btn-cb-outline btn-sm">Mark all read</button>
    </form>
}

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th></th><th>Title</th><th>Body</th><th>Reference</th><th>Received</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="cb-empty-state">No notifications yet.</div></td></tr>
                }
                @foreach (var n in Model)
                {
                    <tr class="@(n.IsRead ? "" : "fw-bold")">
                        <td>@if (!n.IsRead) { <i class="bi bi-circle-fill text-primary" style="font-size:8px;"></i> }</td>
                        <td>@n.Title</td>
                        <td class="fw-normal">@n.Body</td>
                        <td>@n.EntityReference</td>
                        <td class="fw-normal">@n.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex gap-1">
                                @if (n.LinkUrl is not null)
                                {
                                    <a class="btn btn-cb-outline btn-sm" href="@n.LinkUrl">Open</a>
                                }
                                @if (!n.IsRead)
                                {
                                    <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post">
                                        <button type="submit" class="btn btn-cb-outline btn-sm">Mark read</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
