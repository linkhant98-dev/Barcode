@model List<EMS.Domain.Audit.AuditLogEntry>
@{
    var header = new PageHeaderViewModel
    {
        Title = "Audit Log",
        Description = $"{Model.Count} recent entries (append-only).",
        SecondaryActions = { new PageAction("Export CSV", Url.Action("ExportCsv", new { user = ViewBag.UserFilter, module = ViewBag.ModuleFilter })!, "outline", "bi-download") }
    };
}
<partial name="_PageHeader" model="header" />

<div class="cb-filter-bar">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="user" value="@ViewBag.UserFilter" class="form-control" placeholder="User" style="max-width:200px;" />
        <input type="text" name="module" value="@ViewBag.ModuleFilter" class="form-control" placeholder="Module" style="max-width:200px;" />
        <button type="submit" class="btn btn-cb-outline">Filter</button>
        <a class="btn btn-cb-outline" asp-action="Index">Reset</a>
    </form>
</div>

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Module</th><th>Reference</th><th>Result</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="cb-empty-state">No audit entries found.</div></td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.TimestampUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td>@a.UserName</td>
                        <td>@a.Action</td>
                        <td>@a.Module</td>
                        <td>@a.EntityReference</td>
                        <td>@a.Result</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
