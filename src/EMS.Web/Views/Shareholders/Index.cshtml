@model List<EMS.Domain.Shareholders.Shareholder>
@{
    var header = new PageHeaderViewModel
    {
        Title = "Registered Shareholders",
        Description = $"{Model.Count} shareholder(s)",
        SecondaryActions = { new PageAction("Export CSV", Url.Action("ExportCsv", new { q = ViewBag.Query })!, "outline", "bi-download") }
    };
}
<partial name="_PageHeader" model="header" />

<div class="cb-filter-bar">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Search shareholder ID, name..." style="max-width:320px;" />
        <button type="submit" class="btn btn-cb-outline"><i class="bi bi-search"></i> Search</button>
        <a class="btn btn-cb-outline" asp-action="Index">Reset</a>
    </form>
</div>

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>SH ID</th><th>Name</th><th>Group</th><th>Type</th><th>KYC</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7"><div class="cb-empty-state">No shareholders found. Adjust the filters.</div></td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.ShareholderNo</td>
                        <td>@(s.Type == EMS.Domain.Common.ApplicantType.Corporate ? s.Corporate?.LegalNameEn : s.Person?.NameEn)</td>
                        <td>@s.ShareholderGroup?.NameEn</td>
                        <td>@s.Type</td>
                        <td><partial name="_StatusBadge" model="@s.KycStatus.ToString()" /></td>
                        <td><partial name="_StatusBadge" model="@s.Status.ToString()" /></td>
                        <td><a class="btn btn-cb-outline btn-sm" asp-action="Details" asp-route-id="@s.Id">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
