@model List<EMS.Domain.Applications.KycCase>
@{
    var header = new PageHeaderViewModel { Title = "KYC Work Queue", Description = $"{Model.Count} case(s) awaiting decision" };
}
<partial name="_PageHeader" model="header" />

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>Application</th><th>Type</th><th>Requested</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5"><div class="cb-empty-state">No pending KYC cases.</div></td></tr>
                }
                @foreach (var kyc in Model)
                {
                    <tr>
                        <td>@kyc.ShareholderApplication?.ApplicationNo</td>
                        <td>@kyc.ShareholderApplication?.Type</td>
                        <td>@kyc.RequestedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                        <td><partial name="_StatusBadge" model="@kyc.Result.ToString()" /></td>
                        <td><a class="btn btn-cb-outline btn-sm" asp-action="Decide" asp-route-id="@kyc.Id">Review</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
