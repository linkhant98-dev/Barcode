@model List<EMS.Domain.Common.MasterDataEntity>
@{
    var header = new PageHeaderViewModel { Title = "Master Data", Description = "Configurable lookup lists (effective-dated; deactivate instead of delete)." };
    string[] types = ViewBag.Types;
    string selected = ViewBag.SelectedType;
    var isGroups = selected == "ShareholderGroup";
    List<EMS.Domain.MasterData.ShareholderGroup>? mainGroupOptions = isGroups ? ViewBag.MainGroupOptions : null;
}
<partial name="_PageHeader" model="header" />
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

<ul class="nav nav-pills mb-3">
    @foreach (var t in types)
    {
        <li class="nav-item">
            <a class="nav-link @(t == selected ? "active" : "")" asp-action="Index" asp-route-type="@t">@t</a>
        </li>
    }
</ul>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="cb-table-card">
            <div class="cb-table-responsive">
                <table class="cb-table">
                    <thead><tr>@if (isGroups) { <th>Main group</th> }<th>Code</th><th>Name (EN)</th><th>Name (MM)</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="6"><div class="cb-empty-state">No records found.</div></td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                @if (isGroups)
                                {
                                    var group = (EMS.Domain.MasterData.ShareholderGroup)item;
                                    <td>@(group.ParentGroup?.NameEn ?? "—")</td>
                                }
                                <td>@item.Code</td>
                                <td>@item.NameEn</td>
                                <td>@item.NameMm</td>
                                <td><partial name="_StatusBadge" model="@(item.IsActive ? "Active" : "Cancelled")" /></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-type="@selected" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-cb-outline btn-sm">Deactivate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cb-card">
            <h2 class="h6">Add @selected</h2>
            <form asp-action="Create" method="post">
                <input type="hidden" name="Type" value="@selected" />
                <div class="mb-3">
                    <label class="cb-form-label cb-required">Code</label>
                    <input name="Code" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="cb-form-label cb-required">Name (English)</label>
                    <input name="NameEn" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="cb-form-label">Name (Myanmar)</label>
                    <input name="NameMm" class="form-control" />
                </div>
                @if (isGroups)
                {
                    <div class="mb-3">
                        <label class="cb-form-label">Main group</label>
                        <select name="ParentGroupId" class="form-select">
                            <option value="">(this is a main group)</option>
                            @foreach (var g in mainGroupOptions ?? [])
                            {
                                <option value="@g.Id">@g.NameEn</option>
                            }
                        </select>
                        <div class="cb-help-text">Leave as "(this is a main group)" to add a new main group instead of a sub group.</div>
                    </div>
                }
                <button type="submit" class="btn btn-cb-primary w-100">Add</button>
            </form>
        </div>
    </div>
</div>
