@model List<EMS.Domain.Shares.ShareTransaction>
@{
    var header = new PageHeaderViewModel
    {
        Title = "Issue Shares",
        Description = $"{Model.Count} record(s)",
        SecondaryActions = { new PageAction("Export CSV", Url.Action("ExportCsv")!, "outline", "bi-download") },
        PrimaryAction = new PageAction("New Issue", Url.Action("Create")!, "primary", "bi-file-earmark-plus")
    };
}
<partial name="_PageHeader" model="header" />

<div class="cb-table-card">
    <div class="cb-table-responsive">
        <table class="cb-table">
            <thead><tr><th>Reference</th><th>Shareholder</th><th class="numeric">Shares</th><th class="numeric">Total amount</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="cb-empty-state">No share issues found. <a asp-action="Create">Create a new issue-share request</a>.</div></td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TransactionNo</td>
                        <td>@t.ShareIssue?.Shareholder?.ShareholderNo</td>
                        <td class="numeric">@t.ShareIssue?.NumberOfShares.ToString("N0")</td>
                        <td class="numeric">@t.TotalAmount.ToString("N0")</td>
                        <td><partial name="_StatusBadge" model="@t.Status.ToString()" /></td>
                        <td class="d-flex gap-1">
                            <a class="btn btn-cb-outline btn-sm" asp-action="Details" asp-route-id="@t.Id">View</a>
                            @if (t.Status == EMS.Domain.Common.WorkflowStatus.Completed)
                            {
                                <a class="btn btn-cb-outline btn-sm" asp-action="DownloadReceiptPdf" asp-route-id="@t.Id">Receipt</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
