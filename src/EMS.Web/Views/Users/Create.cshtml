@model CreateUserViewModel
@{
    var header = new PageHeaderViewModel { Title = "New User", Description = "Create a new EMS user account." };
}
<partial name="_PageHeader" model="header" />
<partial name="_ValidationSummary" />

<form asp-action="Create" method="post" class="cb-card" style="max-width:560px;">
    <div class="mb-3">
        <label asp-for="FullName" class="cb-form-label cb-required"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="cb-field-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="cb-form-label cb-required"></label>
        <input asp-for="Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Email" class="cb-field-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="cb-form-label cb-required"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="cb-field-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="cb-form-label cb-required"></label>
        <select asp-for="Role" class="form-select" asp-items="ViewBag.Roles">
            <option value="">-- select --</option>
        </select>
    </div>
    <div class="cb-page-actions">
        <a class="btn btn-cb-outline" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-cb-primary">Create User</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
